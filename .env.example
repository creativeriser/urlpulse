# ---------------------------------------------------------------------------
# URLPulse environment. Copy to .env (or run `make init`, which also generates
# the secrets below). Never commit .env.
#
# Values are inserted into connection URLs, so use letters and digits only
# for passwords (openssl rand -hex 24 does exactly that).
# Comments sit on their own lines: Docker Compose, Node and the shell scripts
# all parse that identically.
# ---------------------------------------------------------------------------

# --- Secrets (required by docker-compose.yml) ----------------------------------
MONGO_USER=urlpulse
MONGO_PASSWORD=change-me-hex
REDIS_PASSWORD=change-me-hex
# Salts the IP hash stored with each click. At least 16 characters.
HASH_SALT=change-me-at-least-16-chars
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-hex
# Optional bearer token for /metrics (also configure monitoring/prometheus/prometheus.yml)
METRICS_TOKEN=

# --- Public address -------------------------------------------------------------
# e.g. https://pulse.example.com. Empty = derive from the request Host header.
BASE_URL=
# Host port for nginx. Use 80 in production.
HTTP_PORT=8082

# --- Image (used by docker-compose.prod.yml and scripts/deploy.sh) --------------
# Production: yourdockerhubuser/urlpulse
IMAGE=urlpulse
# Production: sha-<commit>. scripts/deploy.sh rewrites this line on every deploy.
IMAGE_TAG=local

# --- Tuning (all optional; defaults shown) --------------------------------------
# Write requests per IP per 15 minutes
RATE_LIMIT_MAX=100
# Read requests per IP per 15 minutes
READ_RATE_LIMIT_MAX=600
# Public routes (redirects, pages, the 404 page) per IP per minute. Static assets,
# /livez, /health and /metrics are not counted.
PUBLIC_RATE_LIMIT_MAX=600
MONITOR_ENABLED=true
CLICK_RETENTION_DAYS=90
LOG_LEVEL=info

# --- Optional behaviour (all off or derived by default) -----------------------------------
# Browser access to /api from other sites. Off by default. Explicit origins only,
# comma-separated; a wildcard is refused at start-up.
# CORS_ORIGIN=https://app.example.com
# Number of reverse proxies in front of the app (Compose sets 1 for nginx). On a
# platform proxy (for example Render) set 1 and verify client IPs, see the runbook.
# TRUST_PROXY=1

# --- Pinned image tags (uncomment to upgrade) ---------------------------------------
# NGINX_TAG=stable-alpine
# MONGO_TAG=8
# REDIS_TAG=7-alpine
# PROMETHEUS_TAG=v3.5.0
# GRAFANA_TAG=12.1.0

# --- Running the app outside Docker (npm run dev) ---------------------------------------
# With none of these set, the app uses in-memory storage and cache: nothing to install.
# MONGO_URI=mongodb://localhost:27017/urlpulse
# REDIS_URL=redis://localhost:6379
# PORT=5000
