# ---------------------------------------------------------------------------
# TLS example. Rename to tls.conf, mount it next to default.conf, publish 443,
# and mount your certificate files (for example from certbot) into /etc/nginx/certs.
#
# nginx-unprivileged cannot bind 443 inside the container, so listen on 8443 and
# map it on the host:   ports: ["443:8443"]
#
# Also set BASE_URL=https://your.domain in .env so short links are issued as https.
# ---------------------------------------------------------------------------

server {
  listen 8080;
  server_name your.domain;
  return 301 https://$host$request_uri;
}

server {
  listen 8443 ssl;
  http2 on;
  server_name your.domain;
  server_tokens off;

  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # Reuse the same proxy rules as default.conf:
  #   copy the "location = /metrics" and "location /" blocks here.
}
